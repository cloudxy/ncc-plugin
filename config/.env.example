# Dynaconf读取config/default/settings.toml、config/<ENV>/settings.toml，最后加载config/.env。
# 个性化连接及凭据在此初始化；公共默认值在config中维护，无需export。
NCC_ENV="local"
# 正式库保持既定名字；唯一测试库自动命名为“正式库-test”，无需再配一套连接。
NCC_DB_HOST=""
NCC_DB_PORT=""
NCC_DB_NAME=""
NCC_DB_USER=""
NCC_DB_PASSWORD=""

NCC_MODEL_URL=""
NCC_MODEL_KEY=""
NCC_WRITER_MODEL=""
NCC_JUDGE_MODEL=""
NCC_SECOND_JUDGE_MODEL=""

# 仅数据库工作副本需要：在后台生成本范围凭据后填入，不写到书稿目录。
NCC_API_TOKEN=""
# 可选专用读取凭据；留空时MCP沿用API_TOKEN，仍强制只读。
NCC_MCP_TOKEN=""
# 非PATH安装的PostgreSQL工具目录可在初始化时填写。
NCC_PG_BIN=""
