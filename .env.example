# 复制为项目根.env，填写已经确定的连接参数；后续命令自动读取，无需export。
# 正式库保持既定名字；唯一测试库自动命名为“正式库-test”，无需再配一套连接。
NCC_DB_HOST=""
NCC_DB_PORT=""
NCC_DB_NAME=""
NCC_DB_USER=""
NCC_DB_PASSWORD=""

NCC_PUBLIC_ORIGIN="http://127.0.0.1:8787"
NCC_TEST_PUBLIC_ORIGIN="http://127.0.0.1:8788"
NCC_MODEL_URL=""
NCC_MODEL_KEY=""
NCC_WRITER_MODEL=""
NCC_JUDGE_MODEL=""
NCC_SECOND_JUDGE_MODEL=""

# 仅数据库工作副本需要：在后台生成本范围凭据后填入，不写到书稿目录。
NCC_API_URL="http://127.0.0.1:8787"
NCC_API_TOKEN=""
NCC_API_PROFILE="production"
# 非PATH安装的PostgreSQL工具目录可在初始化时填写。
NCC_PG_BIN=""
