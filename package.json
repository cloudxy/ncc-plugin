{
  "name": "ncc-workflow",
  "version": "4.0.0",
  "description": "Novel Create Center：长篇网文从立书到收束的工作流插件。十二个专职角色、三本账、质量闸门、锚定章回归评测、EPUB 导出，含通用创作前准备与素材库治理。",
  "author": {
    "name": "xuyun"
  },
  "homepage": "https://github.com/cloudxy/ncc-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudxy/ncc-plugin.git"
  },
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "plugin.json",
    ".zcode-plugin/plugin.json",
    "AGENTS.md",
    "ACKNOWLEDGMENTS.md",
    "skills",
    "agents",
    "commands",
    "workflow",
    "scripts/cli/*.py",
    "scripts/ncclib/**/*.py",
    "scripts/dev/**/*.py",
    "eval",
    "docs/README.md",
    "docs/guides",
    "docs/engineering",
    "docs/designs",
    "docs/product",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "keywords": [
    "novel",
    "writing",
    "webnovel",
    "workflow",
    "agents",
    "quality-gates",
    "evaluation",
    "epub",
    "memory",
    "self-evolution",
    "dsh"
  ]
}
