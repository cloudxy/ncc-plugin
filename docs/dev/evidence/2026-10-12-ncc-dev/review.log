# Original independent probe program

"""Independent synthetic reproductions. Does not modify the product tree."""
import contextlib
import hashlib
import io
import json
import sys
import tempfile
from pathlib import Path

PRODUCT = Path('/private/tmp/ncc-dev-upgrade-9wztklfl')
sys.path.insert(0, str(PRODUCT / 'scripts'))
from test_dev_workflow import DevWorkflowTest, EntryRegistryTest
import check_dev_workflow as dev

def delivery(t):
    out = io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
        rc = dev.main(['check', str(t.task), '--repo', str(t.root), '--delivery'])
    return {'exit_code': rc, 'output': out.getvalue()}

results = {'reviewed_sha256': {
    f: hashlib.sha256((PRODUCT / f).read_bytes()).hexdigest()
    for f in ['scripts/check_dev_workflow.py', 'scripts/check_plugin.py',
              'scripts/test_dev_workflow.py', 'skills/ncc-dev/SKILL.md', 'docs/dev-workflow.md']}}

t = DevWorkflowTest(); t.setUp()
try:
    t.add_evidence()
    t.write('scripts/product.py', 'print("staged unverified")\n')
    t.run_git('add', 'scripts/product.py')
    t.write('scripts/product.py', 'print("baseline")\n')
    results['staged_unverified_scoped_file'] = {
        **delivery(t), 'index_content': t.run_git('show', ':scripts/product.py'),
        'worktree_vs_base': t.run_git('diff', '--name-only', t.data['base_commit'], '--'),
        'staged_names': t.run_git('diff', '--cached', '--name-only')}
finally:
    t.doCleanups()

t = DevWorkflowTest(); t.setUp()
try:
    t.add_evidence()
    p = t.write('scripts/unowned.py', 'staged unowned\n')
    t.run_git('add', 'scripts/unowned.py')
    p.unlink()
    results['staged_unowned_new_file'] = {
        **delivery(t), 'scope': t.data['scope'],
        'worktree_vs_base': t.run_git('diff', '--name-only', t.data['base_commit'], '--'),
        'staged_names': t.run_git('diff', '--cached', '--name-only')}
finally:
    t.doCleanups()

t = EntryRegistryTest(); t.setUp()
try:
    with tempfile.TemporaryDirectory() as ext:
        extp = Path(ext)
        (extp / 'SKILL.md').write_text('# external synthetic skill\n')
        (t.root / 'skills/entry/SKILL.md').unlink()
        (t.root / 'skills/entry').rmdir()
        (t.root / 'skills/entry').symlink_to(extp, target_is_directory=True)
        results['static_external_skill_source'] = {
            'bad': t.check(),
            'source_outside_root': not (t.root / 'skills/entry').resolve().is_relative_to(t.root.resolve()),
            'mount_target': str((t.root / '.agents/skills/entry').readlink())}
finally:
    t.doCleanups()

print(json.dumps(results, ensure_ascii=False, indent=2))
