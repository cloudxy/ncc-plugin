{
  "schema_version": 2,
  "layers": {
    "L0-soul": {
      "name": "书魂",
      "content": "书魂四问、类型契约、毒点、终局",
      "reversibility": "几乎不可逆",
      "decider": "author",
      "change_via": "G0-soul 或 G4-volume 的变更提议",
      "reader_signal": "不直接影响"
    },
    "L1-skeleton": {
      "name": "骨架",
      "content": "力量体系、地图序列、主要势力、暗线、各卷走向",
      "reversibility": "低",
      "decider": "author+worldbuilder/outliner",
      "change_via": "G4-volume 卷间闸",
      "reader_signal": "经卷复盘间接影响"
    },
    "L2-unit": {
      "name": "单元",
      "content": "10–40 章的剧情单元、爽点弧",
      "reversibility": "中",
      "decider": "author+manager",
      "change_via": "滚动窗更新",
      "reader_signal": "可以影响"
    },
    "L3-chapter": {
      "name": "章",
      "content": "章纲、场景、钩子",
      "reversibility": "高（发布前）",
      "decider": "writer",
      "change_via": "章循环",
      "reader_signal": "可以影响"
    },
    "L4-prose": {
      "name": "文字",
      "content": "句子、对话、描写",
      "reversibility": "最高",
      "decider": "writer+editor",
      "change_via": "随时",
      "reader_signal": "可以影响"
    }
  },
  "stages": {
    "S0-founding": {
      "name": "立书",
      "layer": "L0-soul",
      "roles": [
        "scout"
      ],
      "steps": [
        "作者种子",
        "读技艺库（写过书的作者，craft read）",
        "选题（可跳过，记理由）",
        "三层问答",
        "旧文采样（可选，style）",
        "书魂四问（可暂定，D7）",
        "类型契约与毒点"
      ],
      "book_stage": "founding",
      "gate": "G0-soul"
    },
    "S1-skeleton": {
      "name": "立骨",
      "layer": "L1-skeleton",
      "roles": [
        "worldbuilder",
        "outliner",
        "scholar"
      ],
      "steps": [
        "写作模式（D15）",
        "设定与人物引擎（G1）",
        "大纲（G2，深浅随模式）"
      ],
      "book_stage": [
        "settings",
        "outline"
      ],
      "gate": [
        "G1-settings-frozen",
        "G2-outline-frozen"
      ]
    },
    "S2-opening": {
      "name": "开篇",
      "layer": "L2-unit",
      "roles": [
        "outliner",
        "story-editor",
        "scholar",
        "writer",
        "editor",
        "continuity",
        "pulse",
        "reader"
      ],
      "book_stage": "opening",
      "gate": "G3-opening-accepted"
    },
    "S3-serial": {
      "name": "连载",
      "layer": "L2-unit..L4-prose",
      "roles": [
        "outliner",
        "story-editor",
        "scholar",
        "writer",
        "editor",
        "continuity",
        "pulse",
        "reader"
      ],
      "book_stage": "serial",
      "gate": "G-chapter",
      "steps": [
        "unit open",
        "章循环",
        "单元复盘（report unit）",
        "unit close"
      ]
    },
    "S4-volume": {
      "name": "卷复盘",
      "layer": "L1-skeleton..L2-unit",
      "roles": [
        "story-editor",
        "pulse",
        "outliner",
        "scout"
      ],
      "book_stage": "volume",
      "gate": "G4-volume",
      "steps": [
        "volume end",
        "report volume：承诺盘点、书魂检验、数据归因、变更提议",
        "G4 卷间闸"
      ]
    },
    "S5-finale": {
      "name": "收束",
      "layer": "L0-soul..L2-unit",
      "roles": [
        "outliner",
        "story-editor",
        "continuity",
        "writer"
      ],
      "book_stage": "finale",
      "gate": "G5-finale",
      "steps": [
        "finale begin",
        "report finale：承诺清算、暗线收拢、书魂回答",
        "收束章",
        "书复盘与技艺库",
        "G5 完本闸"
      ]
    }
  },
  "gates": {
    "G0-soul": {
      "decider": "author",
      "checks": [
        "书魂四问齐全（可暂定，暂定须写最晚决定点）",
        "类型契约含主契约与毒点清单",
        "已设引导档位",
        "技艺库里有别的书的条目时，已读并写出技艺库摘录（M6-4）"
      ],
      "source": "scripts/ncc_state.py gate <书目录> soul"
    },
    "G1-settings-frozen": {
      "decider": "author",
      "checks": [
        "设定文件齐全且非空",
        "世界观圣经含社会洞察（不合理却存在的规矩：谁受益、谁受害、主角在哪、对应书魂哪一面）",
        "设定词典条目数 ≥ 30",
        "力量体系含境界阶梯与量纲定义",
        "至少一张完整人物卡（欲望、需要、恐惧、声音）",
        "主角弧光类型已选"
      ],
      "source": "scripts/ncc_state.py gate <书目录> settings"
    },
    "G2-outline-frozen": {
      "decider": "author",
      "checks": [
        "总纲非空",
        "建筑师：卷一卷纲＋黄金三章章纲；混合：当前单元；园丁：只要总纲",
        "承诺台账已登记（园丁模式可事后补记）"
      ],
      "source": "scripts/ncc_state.py gate <书目录> outline"
    },
    "G3-opening-accepted": {
      "decider": "author",
      "checks": [
        "三章硬伤层通过且未改稿后失效",
        "三章都有作者的版本选定",
        "读者盲评至少 2 个画像，各含记忆测试（M6-2）",
        "签约点五项在黄金三章内落地",
        "文风基准的本书校准段已填，文风指纹已生成（M6-1）"
      ],
      "source": "scripts/ncc_state.py gate <书目录> opening"
    },
    "G-chapter": {
      "decider": "script+editor",
      "checks": [
        "场景卡已过故事审且之后未改动",
        "场景卡标了知识的章：知识点清单合格（学科、来源、状态）",
        "check_chapter.py 无必须修的项（钩子、AI 味、水章、复读、截断、占位与拒绝语、工程词漏进叙述）",
        "字数在区间内，或作者已收下当前长度（chapter length --accept；写章循环里按推荐先收、单元复盘确认）；不让写手补写",
        "硬伤层通过",
        "关键章：作者已从 2–3 版中选定",
        "正文变更后已复审（SHA 一致）"
      ],
      "source": "scripts/check_chapter.py；scripts/ncc_state.py complete"
    },
    "G4-volume": {
      "decider": "author",
      "checks": [
        "卷复盘四节齐全（承诺盘点、书魂检验、数据归因、变更提议）",
        "逾期承诺已处置（兑现、带补偿作废或带强化延期）",
        "本卷单元都已关闭",
        "第一卷：书魂已确定（D7）"
      ],
      "source": "scripts/ncc_state.py gate <书目录> volume"
    },
    "G5-finale": {
      "decider": "author",
      "checks": [
        "开放承诺（期权、母题除外）与暂定决策全部清算",
        "书魂已确定",
        "收束清单三节齐全（承诺清算、暗线收拢、书魂回答）",
        "全书复盘已写",
        "技艺库有本书条目且条目表不为空"
      ],
      "source": "scripts/ncc_state.py gate <书目录> finale"
    }
  },
  "writing_modes": {
    "建筑师": "大纲冻结后动笔",
    "园丁": "只定书魂、第一卷方向与主要人物，按场景探索着写，台账事后补记",
    "混合": "默认：书魂与人物先定，情节只规划到当前单元"
  },
  "loops": {
    "章": "ncc-write",
    "单元": "unit open/close＋report unit（loops.md 的「单元循环」）",
    "卷": "volume end＋report volume＋G4（loops.md 的「卷循环」）",
    "书": "全书复盘＋技艺库（loops.md 的「书循环」，finale.md）"
  },
  "stage_table": [
    {
      "stage": "P 创作前准备（可独立、可重入）",
      "layer": "通用资产 / 世界或作品设定",
      "lead": "ncc-prepare",
      "support": "curator（素材库治理）、worldbuilder（设定与虚构素材）、scholar（事实资料），按宿主授权执行",
      "products": "资料与设定的整理、完善、创建成果；来源、关系、采用决定、缺项与范围检查；独立 prepare.json；本库规范、全库处置与批次、实际整理库和取用验证",
      "gate": "范围内准备检查；不替代 G0–G5"
    },
    {
      "stage": "S0 立书",
      "layer": "L0",
      "lead": "经理（按 guidance 引导，先问作者种子）",
      "support": "scout（从种子出整本方向候选）、worldbuilder（有旧文时写文风基准）",
      "products": "作者种子.md、技艺库摘录.md（写过书的作者）、briefing.md、文风指纹与文风基准（有旧文时）、book.json 的书魂与类型契约（author-intent.md 由脚本生成）",
      "gate": "**G0** 书魂闸，作者签字"
    },
    {
      "stage": "S1 立骨·设定",
      "layer": "L1",
      "lead": "worldbuilder",
      "support": "deconstructor（喂料）",
      "products": "写作模式；世界观圣经（含社会洞察）、力量体系（可用小说底盘做底料）、设定词典、规则表、人物卡与采访、主角弧光；素材卡起头",
      "gate": "**G1** 设定冻结"
    },
    {
      "stage": "S1 立骨·大纲",
      "layer": "L1",
      "lead": "outliner",
      "support": "worldbuilder（答疑）",
      "products": "总纲、卷纲/、章纲/（深浅随模式）、名场面与母题、承诺台账",
      "gate": "**G2** 大纲冻结"
    },
    {
      "stage": "S2 开篇",
      "layer": "L2",
      "lead": "writer",
      "support": "outliner、story-editor、editor、continuity、pulse、reader",
      "products": "第 1–3 章（关键章：场景卡作者过目、多版比选）、审稿报告、至少 2 个画像的盲评与记忆测试、弃读热力、文风基准回填与文风指纹、签约点登记",
      "gate": "**G3** 开篇闸"
    },
    {
      "stage": "S3 连载",
      "layer": "L2–L4",
      "lead": "writer",
      "support": "outliner（场景卡）、story-editor（故事审）、editor、continuity、pulse、reader（关键章）",
      "products": "场景卡＋逐章正文＋三本账回写",
      "gate": "**G-chapter** 章定稿闸"
    },
    {
      "stage": "S4 卷复盘",
      "layer": "L1–L2",
      "lead": "story-editor、pulse、outliner",
      "support": "scout（数据归因）",
      "products": "复盘/卷N.md（承诺盘点、书魂检验、数据归因、变更提议）",
      "gate": "**G4** 卷间闸"
    },
    {
      "stage": "S5 收束",
      "layer": "L0–L2",
      "lead": "outliner、continuity",
      "support": "story-editor、writer",
      "products": "收束清单（承诺清算、暗线收拢、书魂回答）、全书复盘、技艺库条目；完本后导出全书（export）",
      "gate": "**G5** 完本闸"
    }
  ]
}
