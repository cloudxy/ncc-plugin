    "lists": "layout.know_dir（ch-NNNN.md）",
    "trigger": "场景卡的\"知识\"一栏；knowledge plan 判断一批要不要派 scholar（一批最多一次）",
    "tool": "ncc_state.py knowledge plan|check、era、study",
    "writer_gets": "知识点清单的\"写成什么\"一栏，不带卡、不带来源"
  },
