{
  "preparation": {
    "schema": 1,
    "state": "prepare.json",
    "work": ".ncc-prepare",
    "output": "成果",
    "tasks": {
      "material-organize": "资料整理",
      "material-improve": "资料完善",
      "material-create": "资料创建",
      "setting-organize": "设定整理",
      "setting-improve": "设定完善",
      "setting-create": "设定创建"
    },
    "natures": [
      "fact",
      "fiction",
      "inference"
    ],
    "item_states": [
      "candidate",
      "accepted",
      "shelved",
      "rejected"
    ],
    "source_kinds": [
      "mixed",
      "material",
      "setting",
      "archive"
    ],
    "text_extensions": [
      ".md",
      ".markdown",
      ".txt"
    ],
    "max_file_bytes": 12582912,
    "what": "独立的创作前准备工作区；资料与设定各自整理、完善、创建。无 book.json 依赖，不接管正文状态。脚本管理来源与交付，语义整理和创作由模型完成。",
    "library": {
      "schema": 1,
      "operations": {
        "library-audit": "按本库规范分区体检；逐项报告路径/行号、证据、严重度与未读部分。脚本检查结构与显式约束，模型复核权威源、术语、信息保真和关系；不因扫描通过宣称语义通过。",
        "library-analyze": "读取实际内容和有效决定，解释混乱的原因与影响；提出分类、文件职责、字段和引用规范，给出方案、推荐及需要作者决定的关键选择；已有授权直接沿用。",
        "library-enrich": "先验证已定标准和完整样例，再分批补全理解与取用所必需的信息；每条保留依据、范围、条件及未核项，不编造事实，不机械填充空字段。",
        "library-refactor": "按规范处理主归属、主题拆分/合并、规则/条目/导航职责和引用；保留独有信息、适用范围与版本例外；实际交付整理后的内容，并验证路径和关联。",
        "library-curate": "治理导航、孤儿、重复候选和作品特例，建立多角度查找路径；依据复用价值与适用范围处置，不因出现人物名就清除内容；回传逐来源处置证据。"
      },
      "dispositions": [
        "retained",
        "transformed",
        "merged",
        "split",
        "excluded",
        "deferred"
      ]
    }
  },
  "knowledge": {
