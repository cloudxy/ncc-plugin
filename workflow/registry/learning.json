        ]
      },
      "writer": {
        "kinds": [
          "原话",
          "决定"
        ],
        "layers": [
          "L3",
          "L4"
        ],
        "chapter": true
      },
      "editor": {
        "kinds": [
          "决定"
        ],
        "layers": [
          "L4"
