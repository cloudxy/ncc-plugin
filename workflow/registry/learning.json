        ],
        "layers": [
          "L1",
          "L2",
          "L3"
        ]
      },
      "story-editor": {
        "kinds": [
          "原话",
          "决定"
        ],
        "layers": [
          "L0",
          "L1",
          "L2",
          "L3"
        ]
      },
      "scholar": {
        "kinds": [
          "决定"
        ],
        "layers": [
