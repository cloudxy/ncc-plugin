    "why_none": "审稿角色与 reader 不拿交接卡：作者的决定只要影响审稿，必然已经落进台账、场景卡或放行清单，审稿看源头；reader 盲读。"
  },
  "decon": {
    "method": "skills/ncc-deconstruct/SKILL.md",
    "chapter_heading": "^\\s*第[〇零一二两三四五六七八九十百千万0-9]+[章回]",
    "index": "索引/chapter_index.json",
    "progress": "_progress.json",
    "ledgers": {
      "伏笔": "台账/伏笔.jsonl",
      "爽点": "台账/爽点.jsonl",
      "情绪": "台账/情绪点.jsonl",
      "钩子": "台账/钩子.jsonl",
      "实体": "实体/实体.jsonl",
      "单元": "台账/单元.jsonl",
      "关系": "台账/关系.jsonl",
      "事件": "台账/事件.jsonl",
      "状态事件": "台账/状态事件.jsonl",
      "信息差": "台账/信息差.jsonl"
    },
    "baseline": "报告/基线.json",
    "baseline_view": "报告/基线.md",
    "forgotten_after": 60,
    "payoff_parts": [
