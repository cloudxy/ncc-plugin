      "见证"
    ],
    "schema_version": 2,
    "plan": "索引/研究计划.json",
    "plan_history": "索引/计划历史",
    "packets": "工作/派单包",
    "contexts": "工作/上下文快照",
    "receipts": "章节/已验收",
    "chapter_dir": "章节",
    "raw_backups": "章节/恢复备份",
    "legacy_snapshot": "工作/legacy快照.json",
    "lock": ".decon.lock",
    "skeleton": "报告/L1-骨架.json",
    "scenes": "剧本/场次.jsonl",
    "scene_views": "剧本/章节",
    "ingest_report": "报告/入库",
    "rejections": "报告/丢弃.jsonl",
    "pending": "报告/待校验.jsonl",
    "conflicts": "报告/冲突.jsonl",
    "alias_index": "实体/别名索引.json",
    "transfer_packet": "工作/L3派单包.json",
    "transfer_report": "报告/L3-方法模块.json",
    "range_reports": "报告/范围",
    "sample_reports": "报告/样本",
    "diagnostics": "索引/诊断.json",
    "reindex_report": "索引/重建影响.json",
    "index_backup": "索引/备份",
    "active_entity_window": 50,
    "foreshadow_ops": [
      "埋",
      "强化",
      "回收"
    ],
    "descriptive_aliases": [
      "女尸",
      "山神",
      "那人",
      "老人",
      "少年",
      "男人",
      "女人"
    ],
    "references": [
      "layers",
      "packet",
      "ingest",
      "screenplay",
      "transfer"
    ],
    "int_ext": [
      "内",
      "外",
      "内/外",
      "未知",
      ""
    ],
    "transfer_inputs": "报告/L3-输入",
    "scene_references": "报告/对标场景卡",
    "index_rules": {
      "version": 2,
      "chapter": "^第([〇零一二两三四五六七八九十百千万0-9]+)[章回](.*)$",
      "volume": "^(?:第[〇零一二两三四五六七八九十百千万0-9]+[卷部篇]|卷[〇零一二两三四五六七八九十百千万0-9]+)(?:\\s.*|[^\\s]*)$",
      "special": "^(?:序|引子|楔子|序章|前言)(?:\\s.*)?$",
      "part": "[（(]([上中下])[）)]\\s*$|\\s([上中下])\\s*$"
    },
    "index_config": "索引/index_config.json"
  },
  "techniques": {
    "method": "skills/ncc-deconstruct/references/transfer.md",
    "required": [
      "类别",
      "手法",
      "怎么做",
      "证据",
      "适用条件",
      "代价与失效",
      "置信级",
      "来源书"
    ],
    "optional": [
      "数据"
    ],
    "locator": [
      5,
      15
    ],
    "overlap_max": 15,
    "per_source_max": 2,
    "method_evidence": 2,
    "general_books": 2,
    "retire_after_bad": 2,
    "status_weight": {
      "已验证": 1.5,
      "手法": 1.0,
      "样本": 0.6
    },
    "stage_of": {
      "founding": "开篇",
      "settings": "开篇",
      "outline": "开篇",
      "opening": "开篇",
      "serial": "连载",
      "volume": "卷末",
      "finale": "收束",
      "finished": "收束"
    },
    "per_role": {
      "scout": {
        "kinds": [
          "大局设计"
        ],
        "max": 3,
        "chars": 900
      },
      "worldbuilder": {
        "kinds": [
          "设定构造",
          "人物塑造"
        ],
        "max": 3,
        "chars": 900
      },
      "outliner": {
        "kinds": [
          "大局设计",
          "剧情规划",
          "爽点规划",
          "暗线伏笔",
          "情绪调用"
        ],
        "max": 5,
        "chars": 1500
      },
      "story-editor": {
        "kinds": [
          "大局设计",
          "剧情规划",
          "爽点规划",
          "暗线伏笔",
          "情绪调用",
          "人物塑造"
        ],
        "max": 5,
        "chars": 1500
      },
      "writer": {
        "kinds": [
          "文笔参考"
        ],
        "max": 2,
        "chars": 300,
        "only_referenced": true
      }
    },
    "never": [
      "continuity",
      "pulse",
      "reader"
    ],
    "why_never": "技法一进审稿就成了判据；reader 盲读。",
    "default_parent": "剧情规划"
  },
  "evolution": {
    "method": "skills/ncc/references/loops.md",
    "tiers": [
      {
        "tier": "自动",
        "what": "记忆的新增、强化、合并、归档；技法卡的状态与权重；技法使用结果的结算",
        "how": "脚本直接执行并留日志，单元复盘用白话列出；可撤回（memory restore、technique restore）"
      },
      {
        "tier": "作者确认",
        "what": "本书新类目、新技法类别、跨书记忆晋升；插件类目表与技法类别表的增补",
        "how": "复盘或闸门时呈给作者；表的增补走 evolve propose → apply --quote"
      },
      {
        "tier": "评测＋作者确认",
        "what": "章节机械检查的阈值与词表",
        "how": "evolve propose → evolve eval（锚定章回归，改动前后对比，变差就拒绝）→ 作者确认 → evolve apply；evolve revert 回到上一版"
      },
      {
        "tier": "永不自动",
        "what": "铁律、公理、七律、谁能看到什么、角色身份",
        "how": "只有作者主动要求，在开发会话里改插件本体"
      }
    ],
    "keys": {
      "check.ai_level1_max": {
        "type": "int",
        "tier": "评测＋作者确认",
        "what": "A 级高危句式与一级词合计上限",
        "default": 3
      },
      "check.para_max": {
        "type": "int",
        "tier": "评测＋作者确认",
        "what": "长段告警阈值（汉字）",
        "default": 200
      },
      "check.sentence_commas_max": {
        "type": "int",
        "tier": "评测＋作者确认",
        "what": "长句告警阈值（逗号数）",
        "default": 10
      },
      "check.dialogue_run_max": {
        "type": "int",
        "tier": "评测＋作者确认",
        "what": "对白流告警阈值（段数）",
        "default": 10
      },
      "check.level1_words": {
        "type": "words",
        "tier": "评测＋作者确认",
        "what": "一级禁用词增删（+词 加，-词 删）",
        "base": "check_words.level1"
      },
      "check.anachronism_words": {
        "type": "words",
        "tier": "评测＋作者确认",
        "what": "时代错置词增删（+词 加，-词 删）",
        "base": "check_words.anachronism"
      },
      "setting.categories": {
        "type": "category",
        "tier": "作者确认",
        "what": "类目表增补（名称＋必填字段）"
      },
      "technique.kinds": {
        "type": "words",
        "tier": "作者确认",
        "what": "技法类别增补（+类别；可用 --parent 指定内置父类，默认剧情规划，继承父类的可见范围）"
      }
    },
    "never": [
      "铁律",
      "公理",
      "七律",
      "可见范围（handoff.visibility、techniques.never、review_words）",
      "角色身份（agents/*.md）"
    ],
    "scan": {
      "category_books": 2,
      "waiver_books": 2,
      "waiver_hits": 3
    }
  }
}
