{
  "style": {
    "fingerprint": "layout.style_fp：句长、段长、对话占比、人称、标点习惯；只给审稿与脚本（铁律 9）",
    "anchor": "layout.style_anchor：语感、本书校准段、负面清单；进写手包，动笔前最后读",
    "source": "开书时作者旧文样本（≥1 万字，style --sample）；没有就第 1 章定稿后反推（style --from-chapters 1）",
    "drift": "check_chapter.py 对照指纹给文风漂移提醒，只告警，审稿判断",
    "owner": "worldbuilder（task: style）起草，作者确认"
  },
  "preferences": {
    "file": "layout.prefs（version 2）",
    "tool": "ncc_state.py pref show|like|confirm|reject|dislike",
    "decay": "权重按半衰期衰减（默认 180 天，half_life_days）；confirm 重新计时",
    "rejected": "否决降权并记原因，同类问题不首推；后来又选了则撤销否决",
    "dislikes": "雷点：硬约束，不衰减"
  },
  "craft_library": {
    "dir": "layout.craft_library（<书名>.md）",
    "write": "完本后 craft init 生成模板，条目表：一句话｜证据｜适用条件｜标签（G5 查不为空）",
    "read": "下一本书开书时 craft read：按题材、主契约、弧光、写作模式挑相关条目（适用条件\"通用\"的总挑出），写 00-策划/技艺库摘录.md（G0 查）",
    "priority": "推荐理由：作者种子 > 技艺库 > 题材常规"
  },
  "memory": {
    "method": "skills/ncc/references/memory.md",
    "caps": {
      "book_chars": 600,
      "book_items": 20,
      "shared_chars": 300
    },
    "min_evidence": 2,
    "once_ok": [
      "约定"
    ],
    "stale_units": 2,
    "promote_hits": 3,
    "similar": 0.5,
    "roles": {
      "manager": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书约定、作者的工作节奏（什么时候可以打扰）",
        "never": "作者偏好（在 pref）"
      },
      "scout": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书约定、选题与归因上反复出的问题",
        "never": "正文细节"
      },
      "worldbuilder": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书约定、设定上反复出的问题、作者选定的设定手感",
        "never": "正文细节"
      },
      "outliner": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书约定、场景卡与大纲上反复出的问题、作者选定的规划手感",
        "never": "正文细节"
      },
      "story-editor": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书约定、故事审里反复出的问题",
        "never": "正文细节"
      },
      "scholar": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书已核实的口径、常错的知识点",
        "never": "—"
      },
      "writer": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "写成什么：教训和手感都转成写法",
        "never": "审稿判据、书魂原文、评分",
        "guard": true
      },
      "editor": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "本书常用的修法、放行过的写法",
        "never": "—",
        "guard": true
      },
      "continuity": {
        "kinds": [
          "约定",
          "教训"
        ],
        "keeps": "本书约定（避免误报）、自己的误报与漏检",
        "never": "生产方的讨论、写手记忆"
      },
      "pulse": {
        "kinds": [
          "约定",
          "教训"
        ],
        "keeps": "本书约定（避免误报）、自己的误报与漏检",
        "never": "生产方的讨论、写手记忆"
      },
      "reader": {
        "kinds": [
          "校准"
        ],
        "keeps": "画像校准：模拟追读与真实追读的偏差规律",
        "never": "其他一切"
      },
      "deconstructor": {
        "kinds": [
          "约定",
          "教训",
          "手感"
        ],
        "keeps": "拆书口径约定（别名归一的规矩等）",
        "never": "—"
      }
    },
    "recall": {
      "*": [
        "memory",
        "memory_log",
        "handoff",
        "scenes",
        "reviews",
        "ledgers"
      ],
      "writer": [
        "memory",
        "handoff",
        "scenes",
        "ledgers"
      ],
      "editor": [
        "memory",
        "handoff",
        "scenes",
        "ledgers"
      ],
      "continuity": [
        "memory",
        "scenes",
        "reviews",
        "ledgers"
      ],
      "pulse": [
        "memory",
        "scenes",
        "reviews",
        "ledgers"
      ],
      "reader": [
        "memory"
      ]
    }
  },
  "handoff": {
    "method": "skills/ncc/references/memory.md",
    "writer_chars": 300,
