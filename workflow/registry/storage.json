{
  "ledgers": {
    "promises": {
      "answers": "我们欠读者什么",
      "tool": "ncc_state.py promise",
      "layout": "promises"
    },
    "knowledge_states": {
      "answers": "谁知道什么",
      "tool": "ncc_state.py know",
      "layout": "knowledge"
    },
    "world": {
      "answers": "世界此刻是什么样",
      "tool": "ncc_state.py fact（知识台账，数据的唯一源）、event add（状态事件，只追加）；主角失去的东西 --attr 失去",
      "layout": [
        "events",
        "facts",
        "bible"
      ]
    },
    "reader_data": {
      "answers": "读者实际怎么反应（真实）与模拟读者怎么判断（模拟）",
      "tool": "ncc_state.py feedback",
      "layout": "reader_data"
    },
    "oplog": {
      "answers": "谁在什么时候做了什么写操作（团队交接）",
      "tool": "ncc_state.py 自动追加；操作者取环境变量 NCC_ACTOR",
      "layout": "oplog"
    }
  },
