  "layout": {
    "book_json": {
      "path": "book.json",
      "kind": "源头",
      "what": "阶段、闸门、章节状态、写作模式、档位、时代背景",
      "writer": "只经 ncc_state.py（gate、chapter、mode、level、era…）",
      "view": "status",
      "fields": [
        {
          "field": "soul",
          "what": "书魂四问、主角弧光",
          "writer": "作者拍板后 soul",
          "view": "author-intent.md"
        },
        {
          "field": "contract",
          "what": "类型契约、毒点、目标读者、签约点",
          "writer": "作者拍板后 contract（含 --audience）、sign",
          "view": "author-intent.md"
        },
        {
          "field": "chapters[].end",
          "what": "每章结束时的时间、地点、下一章要接的事",
          "writer": "chapter end",
          "view": "current-focus.md（续写状态卡）"
        },
        {
          "field": "setting_categories",
          "what": "本书用哪些设定类目、本书新提的类目与字段、为什么",
          "writer": "作者在 G1 确认后 setting use/new/none",
          "view": "setting list"
        },
        {
          "field": "benchmarks",
          "what": "本书的对标书（拆书库里的书名），单元复盘拿它的基线作参照",
          "writer": "decon link",
          "view": "单元复盘底稿"
        }
      ]
    },
    "intent_view": {
      "path": "author-intent.md",
      "kind": "视图",
      "what": "书魂、类型契约、目标读者、签约点、作者雷点",
      "writer": "render 生成，勿手改"
    },
    "focus_view": {
      "path": "current-focus.md",
      "kind": "视图",
      "what": "续写状态卡：上一章结束在何时何地、下一章要接什么、近三章的翻转、读者此刻",
      "writer": "render 生成，勿手改"
    },
    "seeds": {
      "path": "00-策划/作者种子.md",
      "kind": "作者",
      "what": "作者种子（原话）",
      "writer": "经理按作者原话记",
      "view": "写手包带 #1、#3、#6"
    },
    "briefing": {
      "path": "00-策划/briefing.md",
      "kind": "角色",
      "what": "选题一页纸：题材、对标、差异点、目标读者、爽点承诺",
      "writer": "scout"
    },
    "benchmark": {
      "path": "00-策划/对标分析.md",
      "kind": "角色",
      "what": "对标书分析",
      "writer": "scout"
    },
    "change_log": {
      "path": "00-策划/变更提议.md",
      "kind": "历史",
      "what": "冻结后的变更提议与作者决定（只追加）",
      "writer": "经理"
    },
    "craft_excerpt": {
      "path": "00-策划/技艺库摘录.md",
      "kind": "视图",
      "what": "别的书里与本书相关的经验",
      "writer": "craft read 生成"
    },
    "review_dir": {
      "path": "00-策划/复盘",
      "kind": "角色",
      "what": "单元、卷、全书复盘：生成区块是台账数据，区块外是作者与角色的判断",
      "writer": "report --write；作者与角色",
      "dir": true,
      "eg": "单元-U1.md、卷1.md、全书.md"
    },
    "finale_list": {
      "path": "00-策划/收束清单.md",
      "kind": "角色",
      "what": "收束清单：生成区块是数据，区块外是清算方案",
      "writer": "report finale --write；outliner 与作者"
    },
    "bible": {
      "path": "01-设定/世界观圣经.md",
      "kind": "角色",
      "what": "世界的规则与关系、社会洞察（不写具体数据，写知识台账的键）",
      "writer": "worldbuilder；冻结后走变更提议"
    },
    "power": {
      "path": "01-设定/力量体系.md",
      "kind": "角色",
      "what": "境界阶梯、量纲定义、越级例外",
      "writer": "worldbuilder；冻结后走变更提议"
    },
    "lexicon": {
      "path": "01-设定/设定词典.md",
      "kind": "角色",
      "what": "专名：首现章计划、读者已知、完整真相、计划揭示章",
      "writer": "worldbuilder；写手修正首现章实值"
    },
    "rules_table": {
      "path": "01-设定/规则表.md",
      "kind": "角色",
      "what": "克制链、兑换率（只对本书有效）",
      "writer": "worldbuilder"
    },
    "categories": {
      "path": "01-设定/类目",
      "kind": "角色",
      "what": "设定类目卡：门派、种族、血脉、企业……本书用哪些类目由 worldbuilder 研判、作者在 G1 确认（类目表在注册表，本书的选择在 book.json）",
      "writer": "setting add 建卡，worldbuilder 填",
      "view": "setting list；派单头",
      "dir": true,
      "on_demand": true,
      "eg": "门派/青云宗.md"
    },
    "anachronism": {
      "path": "01-设定/时代错置词.md",
      "kind": "角色",
      "what": "本书特有的时代错置词（可选）",
      "writer": "worldbuilder"
    },
    "characters": {
      "path": "01-设定/人物卡",
      "kind": "角色",
      "what": "人物卡与角色采访；秘密是什么写这里，谁知道记知情台账",
      "writer": "worldbuilder",
      "dir": true,
      "eg": "<名字>.md、<名字>-采访.md"
    },
    "master_outline": {
      "path": "02-大纲/总纲.md",
      "kind": "角色",
      "what": "主线、分卷目录、结局方向；名场面与母题只引用编号",
      "writer": "outliner"
    },
    "volume_outlines": {
      "path": "02-大纲/卷纲",
      "kind": "角色",
      "what": "卷纲",
      "writer": "outliner",
      "dir": true,
      "eg": "卷1.md"
    },
    "chapter_outlines": {
      "path": "02-大纲/章纲",
      "kind": "角色",
      "what": "章纲（建筑师模式）",
      "writer": "outliner",
      "dir": true,
      "eg": "ch-0001.md"
    },
    "scene_dir": {
      "path": "02-大纲/场景卡",
      "kind": "源头",
      "what": "每章要发生的事：视角、目标、翻转、两难、情感（关键章十项）",
      "writer": "outliner 起草，过故事审",
      "view": "写手包；current-focus.md 的近三章",
      "dir": true,
      "eg": "ch-0001.md"
    },
    "know_dir": {
      "path": "02-大纲/知识点",
      "kind": "角色",
      "what": "本章知识点清单：知识点、学科、写成什么、来源、状态",
      "writer": "scholar",
      "view": "写手包（只带写成什么）",
      "dir": true,
      "eg": "ch-0001.md"
    },
    "style_anchor": {
      "path": "03-文风/文风基准.md",
      "kind": "角色",
      "what": "语感、本书校准段、负面清单（进写手包）",
      "writer": "worldbuilder（task: style），作者确认"
    },
    "style_fp": {
      "path": "03-文风/文风指纹.json",
      "kind": "源头",
      "what": "文风的数字指纹（只给审稿与脚本）",
      "writer": "style 生成"
    },
    "waivers": {
      "path": "03-文风/放行清单.md",
      "kind": "作者",
      "what": "作者认定有意为之的原句（附章号与理由）",
      "writer": "作者"
    },
    "chapters": {
      "path": "04-正文",
      "kind": "角色",
      "what": "正文",
      "writer": "writer；修订由 editor",
      "dir": true,
      "eg": "第0001章-标题.md"
    },
    "versions": {
      "path": "04-正文/_versions",
      "kind": "角色",
      "what": "关键节拍的多版，作者比选",
      "writer": "writer",
      "dir": true,
      "on_demand": true,
      "eg": "ch-0001-<节拍>-A.md"
    },
    "reviews": {
      "path": "05-审稿",
      "kind": "角色",
      "what": "故事审、审稿报告、盲评",
      "writer": "经理落盘角色的报告",
      "dir": true,
      "eg": "story-ch-0001.md、ch-0001-review.md、blind-ch-0001-0003-<画像>.md"
    },
    "reader_data": {
      "path": "05-审稿/读者数据.json",
      "kind": "源头",
